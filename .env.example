# Образец файла окружения. Скопировать в .env и заполнить.
# Сам .env в репозиторий не попадает.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=замените-на-случайную-строку
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=rvp
POSTGRES_USER=rvp
POSTGRES_PASSWORD=rvp
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5442

MEDIA_ROOT=media
MAX_UPLOAD_SIZE_MB=25
Q_WORKERS=2
LOG_LEVEL=INFO

# Только для сервера
# DJANGO_CSRF_TRUSTED_ORIGINS=https://rapport.example.ru
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_HSTS_SECONDS=0
# EMAIL_HOST=
# EMAIL_PORT=25
# DEFAULT_FROM_EMAIL=rvp-report@example.ru
