# Образец файла окружения. Скопировать в .env и заполнить.
# Сам .env в репозиторий не попадает.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=замените-на-случайную-строку
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=rvp
POSTGRES_USER=rvp
POSTGRES_PASSWORD=rvp
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5442

MEDIA_ROOT=media
MAX_UPLOAD_SIZE_MB=25
Q_WORKERS=2
LOG_LEVEL=INFO

# --- Только для сервера ---
# Порядок установки описан в docs/deploy.md.
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_CSRF_TRUSTED_ORIGINS=https://rapport.example.ru
# DJANGO_SECURE_SSL_REDIRECT=true
#
# HSTS включать только после того, как сертификат заработал устойчиво:
# ошибочно включённый заголовок закрывает доступ к сайту на весь срок.
# DJANGO_HSTS_SECONDS=31536000
#
# Собирать ли образ с LibreOffice для перевода презентаций в PDF.
# Без него приложение работает, но кнопка PDF скажет, что перевод
# недоступен. Прибавляет к образу около полугигабайта.
# WITH_PDF=1
#
# Рабочие процессы и тайм-аут gunicorn.
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120
#
# Резервное копирование: куда класть и сколько хранить.
# BACKUP_DIR=/opt/rvp-report/deploy/backup
# BACKUP_KEEP_DAYS=30
#
# Почта нужна только для восстановления пароля и напоминаний.
# EMAIL_HOST=
# EMAIL_PORT=25
# DEFAULT_FROM_EMAIL=rvp-report@example.ru
