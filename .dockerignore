# Что не должно попадать в образ.
#
# Дело не только в размере. Без этого файла в образ копируются
# каталог с суточными рапортами и хранилище загруженных файлов —
# то есть коммерческая тайна и персональные данные оказываются
# внутри образа, который потом уезжает в реестр и на другие узлы.
# Образ — это код, данные приходят в него томами.

# Данные и секреты
.env
.env.*
data_august/
raports/
media/
deploy/tls/
deploy/backup/
*.xlsx
*.pptx

# Окружение разработки
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Статика собирается при запуске контейнера
staticfiles/

# История и настройки редакторов
.git/
.github/
.gitignore
.gitattributes
.idea/
.vscode/
.claude/

# Проверки и документация в работающем приложении не нужны
tests/
docs/
*.md
!README.md
